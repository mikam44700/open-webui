# syntax=docker/dockerfile:1

ARG OPEN_WEBUI_BASE_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0@sha256:72c0ba641ba75e7aa52655cb242570906ececd09b1140fb736483038a22b3228

FROM --platform=$BUILDPLATFORM node:22-alpine3.20 AS frontend

WORKDIR /app

RUN apk add --no-cache git

COPY package.json package-lock.json ./
RUN npm ci --force

COPY . .
ARG BUILD_HASH=fr-local
ENV APP_BUILD_HASH=${BUILD_HASH}
# La page Moteur ajoute ~19 000 lignes et 129 images au bundle : 4 Go ne suffisent plus
# a Rollup, qui s'arretait sur « JavaScript heap out of memory ».
ENV NODE_OPTIONS=--max-old-space-size=6144
RUN npm run pyodide:fetch
RUN npx vite build

FROM ${OPEN_WEBUI_BASE_IMAGE}

RUN find /app/build -depth -delete
COPY --from=frontend /app/build /app/build

# The French image is based on the official backend image, so local backend
# extensions must be copied explicitly alongside the rebuilt frontend.
#
# Every new router needs a line here. Forgetting one does not fail the build:
# the image is built, the container starts, and only then does uvicorn die with
# "cannot import name X from open_webui.routers" — on a restart loop, several
# minutes after the build reported success.
COPY --from=frontend /app/backend/open_webui/main.py /app/backend/open_webui/main.py
COPY --from=frontend /app/backend/open_webui/routers/hermes.py /app/backend/open_webui/routers/hermes.py
COPY --from=frontend /app/backend/open_webui/routers/composio.py /app/backend/open_webui/routers/composio.py
COPY --from=frontend /app/backend/open_webui/routers/kanban.py /app/backend/open_webui/routers/kanban.py

ARG BUILD_HASH=fr-local
ENV WEBUI_BUILD_VERSION=${BUILD_HASH}
